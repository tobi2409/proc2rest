{
  "clients": [{
    "filename": "index.html",
    "servers": []
  }, {
    "filename": "index.js",
    "servers": ["my-server.ts"]
  }, {
    "filename": "page-two.html",
    "servers": []
  }, {
    "filename": "page-two.js",
    "servers": ["my-server.ts"]
  }],
  "servers": ["my-server.ts"],
  "rawServerFiles": ["my-server-raw.ts"],
  "apiUrl": "http://localhost:3000",
  "cors": {
    "origin": "*"
  },
  "method-rules": {
    "GET": "^(get|list|find)",
    "POST": "^(create|add|insert)",
    "PATCH": "^(update|set|patch)",
    "DELETE": "^(delete|remove)"
  },
  "method-rules-custom-functions": {
    "getBinDataInfo": "POST"
  },
  "binaryTypes": [
    "ArrayBuffer",
    "Uint8Array",
    "Uint8Array<ArrayBufferLike>",
    "Buffer",
    "Blob",
    "ImageData",
    "File",
    "ReverseResult"
  ]
}